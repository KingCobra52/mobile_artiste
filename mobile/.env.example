# Copy to .env. The real .env is gitignored by the repo root's .gitignore.
#
# EXPO_PUBLIC_* variables are inlined into the JS bundle at build time and are
# readable by anyone with the app. Never put secrets here - the database URL and
# API keys belong in ../.env, which the FastAPI process reads server-side.

# localhost works on the iOS Simulator because it shares the host's network stack.
# For a physical device over Expo Go, change this to the host machine's LAN IP,
# e.g. http://192.168.1.42:8000
#
# src/lib/api.ts falls back to this same value when the variable is unset, so the
# simulator works without a .env at all.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth. The publishable key is designed to ship in client bundles - Row
# Level Security is what actually protects the data. Safe to commit, but this
# file exists so a fresh clone knows the variables are required.
EXPO_PUBLIC_SUPABASE_URL=https://rrszfaufhqagrhgvzfky.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_VWntyvCPV6704WsEbpDA5Q_2FxybL9G
